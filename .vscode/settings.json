{
    "code-runner.executorMap": {
        "python": "cd Windows_and_Linux && uv run python"
    },
    "code-runner.respectShebang": false,
    "code-runner.clearPreviousOutput": true,
    "code-runner.runInTerminal": true,
    "[python]": {
        "editor.defaultFormatter": "charliermarsh.ruff",
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": {
            "source.fixAll.ruff": "explicit",
            "source.organizeImports.ruff": "explicit"
        }
    },
    "python.defaultInterpreterPath": "./Windows_and_Linux/.venv/Scripts/python.exe",
    "ruff.configuration": "./Windows_and_Linux/pyproject.toml",
    "ruff.path": ["./Windows_and_Linux/.venv/Scripts/ruff.exe"],
    "python.languageServer": "Pylance",
    "python.analysis.extraPaths": ["./Windows_and_Linux/src"],
    "search.exclude": {
        "**/build": true,
        "**/__pycache__": true,
        "**/.venv": true,
        "**/.git": true
    }
}